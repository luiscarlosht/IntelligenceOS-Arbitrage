# PROPOSAL ONLY. Copy/configure only after separate deployment authorization.
ARBITRAGE_GMAIL_SCHEDULE_ENABLED=false
# Set true only after reviewing publishing requirements and fresh offline consent.
# This is an operator attestation; the application cannot query consent status.
ARBITRAGE_GMAIL_OAUTH_READY=false
ARBITRAGE_EMAIL_TRANSPORT=gmail_api
ARBITRAGE_GMAIL_TOKEN_FILE=/var/lib/intelligenceos-arbitrage-gmail-private/token.json
ARBITRAGE_GMAIL_STAGE_FILE=/var/lib/intelligenceos-arbitrage-gmail-report/delivery.stages.jsonl
EMAIL_FROM=
EMAIL_TO=
JOB_INTERVAL_SECONDS=0
ARBITRAGE_MODE=discovery
AMAZON_PROVIDER=mock
ARBITRAGE_REPORT=/var/lib/intelligenceos-arbitrage-gmail-report/discovery-mock.xlsx
ARBITRAGE_DB=/var/lib/intelligenceos-arbitrage-gmail-report/history.sqlite3
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
